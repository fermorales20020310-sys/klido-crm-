<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>KLIDO Public View - Tiempo Real</title><style>body{font-family:Inter,Arial;background:#0b1020;color:#fff;padding:20px}.card{background:#131b2e;border:1px solid #1e2a4a;border-radius:14px;padding:16px;margin:12px 0}.kpi{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.kpiCard{background:#1e293b;border:1px solid #2a3a5c;border-radius:12px;padding:14px;text-align:center}.live{width:10px;height:10px;background:#22c55e;border-radius:50%;display:inline-block;animation:blink 1s infinite}@keyframes blink{0%,100%{opacity:1}50%{opacity:0.3}}</style></head><body>
<h2>KLIDO Public View <span class="live"></span> Tiempo Real <span id="time"></span></h2><div id="info">Cargando...</div><div class="kpi" id="kpi"></div><div id="details"></div>
<script>
const eid=new URLSearchParams(location.search).get('eid');
if(!eid){document.getElementById('info').innerHTML='Falta ?eid=ID';}
async function load(){
  const r=await fetch('/api/public/'+eid); const j=await r.json(); if(!j.ok) return;
  document.getElementById('info').innerHTML=`<div class="card"><b>Empresa:</b> ${j.empresa} | <b>Plan:</b> <span style="background:#f59e0b;color:#000;padding:2px 8px;border-radius:10px">${j.plan.toUpperCase()}</span> | <b>Estado:</b> ${j.plan_activo?'<span style="color:#22c55e">ACTIVO</span>':'<span style="color:#ef4444">BLOQUEADO</span>'} | <b>Vence:</b> ${j.vence} | Actualizado: ${new Date(j.updated).toLocaleTimeString()}</div>`;
  document.getElementById('kpi').innerHTML=`<div class="kpiCard"><div style="font-size:28px;font-weight:800">${j.stats.chats}</div><div style="font-size:11px;color:#94a3b8">CHATS</div></div><div class="kpiCard"><div style="font-size:28px;font-weight:800">${j.stats.mensajes}</div><div style="font-size:11px">MENSAJES</div></div><div class="kpiCard"><div style="font-size:28px;font-weight:800">${j.stats.trabajadores}</div><div style="font-size:11px">TRABAJADORES</div></div><div class="kpiCard"><div style="font-size:28px;font-weight:800">${j.stats.campanas}</div><div style="font-size:11px">CAMPAÑAS</div></div>`;
  document.getElementById('time').innerText=new Date().toLocaleTimeString();
}
setInterval(load,5000); load();
</script></body></html>
